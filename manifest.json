{
  "manifest_version": 3,
  "name": "ASIN List to JSON",
  "version": "1.1.0",
  "description": "Export the ASIN result table on the query editor page to a JSON file, with serial numbers and a timestamped filename.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Download ASINs as JSON",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
